# generated by /plugin-types; version-specific, so it never ships
.claude/*
!.claude/settings.json
mods/*/.claude/
# the engine lays a mod's types here when it loads the folder; same story
mods/*/.claude-plugin/types/

node_modules/
bun.lock
.DS_Store
__pycache__/

# fetch-quotes-shioaji.py chdir's into the runtime dir before shioaji writes
# this, so it should never land here - this line is just a safety net
shioaji.log

# fetch-quotes-capital.py points SKCenterLib_SetLogPath at the runtime dir, so
# SKCOM's log should never land here either - same safety net
CapitalLog/

# 群益's SDK download: a third-party zip with no business in this repo. Unzip it
# somewhere stable outside the tree and point capital.dll at it - see
# mods/tw-stock-mod/references/quote-sources.md §4.
CapitalAPI_*_PythonExample.zip

# observability hook state, written per session
.runtime/

# local demo holdings render into these design mockups; demo numbers stay out of git
mods/tw-stock-mod/prototype/pnl-styles/

# internal working notes and plans stay local
task-tracker.md
docs/plan-*.md
